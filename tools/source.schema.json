{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Schema for src/<name>/source.json, the hand-written metadata of one package. This file sits outside tools/schemas/, which holds only the vendored published schema. The published Agent Plugins schema owns the name pattern. It applies that pattern to the built plugins/<name>/plugin.json, so this schema only requires a non-empty name.",
  "title": "Package source metadata",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "author",
    "homepage",
    "repository",
    "license",
    "keywords",
    "category"
  ],
  "additionalProperties": false
}
